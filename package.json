    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"

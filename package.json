    "db:validate": "prisma validate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "next-auth": "^5.0.0-beta.30",
    "@auth/prisma-adapter": "^2.11.0",
    "@prisma/client": "^7.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "bcryptjs": "^3.0.2",
    "zod": "^4.2.0",
    "pg": "^8.16.0",
    "dotenv": "^17.2.0",
    "idb": "^8.0.3",
    "recharts": "^3.4.0",
    "openai": "^6.15.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",

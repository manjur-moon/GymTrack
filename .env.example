# COPY TO .env BEFORE npm install (Prisma postinstall uses DIRECT_URL)
DATABASE_URL="postgresql://gymtrack:gymtrack@localhost:5432/gymtrack?schema=public"
DIRECT_URL="postgresql://gymtrack:gymtrack@localhost:5432/gymtrack?schema=public"
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
AUTH_TRUST_HOST="true"
# Optional: only if configured in Google Cloud Console
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: Natural-language parser (without key manual logging still works)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Required only to seed a real admin or coach via own scripts
